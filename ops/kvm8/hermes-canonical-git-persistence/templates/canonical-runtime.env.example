# Sanitized KVM8 template. Do not put secrets here.
HERMES_UPDATE_GIT_REPO=<CANONICAL_RELEASE>
HERMES_CANONICAL_REPO=<CANONICAL_RELEASE>
HERMES_CANONICAL_PM_LAUNCHER=<CANONICAL_RELEASE>/.hermes/bin/hermes
HERMES_PREFLIGHT_PYTHON=/root/.hermes/tools/python-3.14.7+20260901-linux-x64/bin/python
HERMES_GATE_PYTHONPATH=<PRIVATE_READ_ONLY_PYYAML_SITE_PACKAGES>
HERMES_UPDATE_TIMER_STATE=disabled
HERMES_PROMOTION_MODE=explicit_authorization_only
HERMES_LEGACY_FALLBACK=prohibited
